# =======================================================
# LoanPoint V3 - Backend Environment Configuration
# =======================================================
# Operating Environment (development | production)
NODE_ENV=development

# Server Port and Host Binding
PORT=4000
HOST=0.0.0.0

# CORS Allowed Origins (* or https://yourdomain.com)
CORS_ORIGINS=*

# OTP Mode (development | production)
# In development, demo OTPs (123456 customer / 987654 admin) are enabled with rate limiting.
# In production, a real SMS provider MUST be configured; the server will refuse to start in demo mode.
OTP_MODE=development

# Database Connection (Neon PostgreSQL - server-side only)
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/neondb?sslmode=require

# ImageKit Storage (Private key is strictly server-side)
# IMPORTANT: Provide a fresh/rotated ImageKit private key here.
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_new_rotated_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Cryptographic JWT Secret (Minimum 32 characters required)
# Server will refuse to start if missing or under 32 characters.
JWT_SECRET=your_super_strong_min_32_char_secret_key_here

# Admin Authentication
# Must be configured in .env; server will refuse to use hardcoded credentials
ADMIN_MOBILE=9545555999
# Set either ADMIN_PIN or ADMIN_PASSWORD_HASH
ADMIN_PIN=your_secure_admin_pin
ADMIN_PASSWORD_HASH=
