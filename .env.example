# Indian States and Districts Data API URL
EXPO_PUBLIC_INDIA_STATES_DISTRICTS_URL=https://raw.githubusercontent.com/codingmation/indian-states-districts/main/data/india_states_districts.min.json

# Google Places API Configuration
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=your_google_places_api_key
EXPO_PUBLIC_GOOGLE_PLACE_ID=your_google_place_id
EXPO_PUBLIC_GOOGLE_MAPS_URL=https://maps.app.goo.gl/example

# Backend API Base URL for React Native App
# On real Android phone on same Wi-Fi: http://<YOUR_PC_LAN_IP>:4000/api/v1
# On Android emulator: http://10.0.2.2:4000/api/v1
# In production: https://api.yourdomain.com/api/v1
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.8:4000/api/v1

# ImageKit Public Storage Configuration (Public parameters only)
EXPO_PUBLIC_IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
EXPO_PUBLIC_IMAGEKIT_ID=your_imagekit_id
EXPO_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
